    <class>DashboardWindow</class>
    <widget class="QMainWindow" name="DashboardWindow">
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>0</y>
                <width>1100</width>
                <height>700</height>
            </rect>
        </property>
        <property name="minimumSize">
            <size>
                <width>950</width>
                <height>600</height>
            </size>
        </property>
        <property name="windowTitle">
            <string>Phone Store - Dashboard</string>
        </property>

        <widget class="QWidget" name="centralwidget">
            <property name="styleSheet">
                <string notr="true">
                    QWidget#centralwidget {
                    background-color: #F5F7FA;
                    }

                    QFrame#sideBar {
                    background-color: #FFFFFF;
                    border-right: 1px solid #E0E0E0;
                    }

                    QLabel#lblLogo {
                    color: #3478F6;
                    font-size: 20px;
                    font-weight: bold;
                    }

                    /* ===== SIDEBAR BUTTONS ===== */

                    QPushButton {
                    text-align: left;
                    background-color: transparent;
                    color: #555555;
                    border: none;
                    border-radius: 8px;
                    padding: 12px 16px;
                    font-size: 14px;
                    }

                    QPushButton:hover {
                    background-color: #F0F4FF;
                    color: #3478F6;
                    }

                    /* Button đang được chọn */
                    QPushButton[active="true"] {
                    background-color: #EAF1FF;
                    color: #3478F6;
                    font-weight: bold;
                    }

                    QPushButton[active="true"]:hover {
                    background-color: #EAF1FF;
                    color: #3478F6;
                    }

                    /* Logout */
                    QPushButton#btnLogout {
                    color: #777777;
                    }

                    QPushButton#btnLogout:hover {
                    background-color: #FFF1F1;
                    color: #D93025;
                    }

                    /* ===== DASHBOARD ===== */

                    QLabel#lblWelcome {
                    color: #202124;
                    font-size: 26px;
                    font-weight: bold;
                    }

                    QLabel#lblSubtitle {
                    color: #777777;
                    font-size: 14px;
                    }

                    /* ===== STAT CARDS ===== */

                    QFrame#cardProducts,
                    QFrame#cardOrders,
                    QFrame#cardCustomers {
                    background-color: #FFFFFF;
                    border: 1px solid #E0E0E0;
                    border-radius: 12px;
                    }

                    QLabel#productsTitle,
                    QLabel#ordersTitle,
                    QLabel#customersTitle {
                    color: #777777;
                    font-size: 13px;
                    }

                    QLabel#productsValue,
                    QLabel#ordersValue,
                    QLabel#customersValue {
                    color: #202124;
                    font-size: 28px;
                    font-weight: bold;
                    }

                    /* ===== RECENT ===== */

                    QLabel#lblRecent {
                    color: #202124;
                    font-size: 18px;
                    font-weight: bold;
                    }

                    QFrame#recentCard {
                    background-color: #FFFFFF;
                    border: 1px solid #E0E0E0;
                    border-radius: 12px;
                    }

                    /* ===== OTHER PAGES ===== */

                    QLabel#productsPageTitle,
                    QLabel#categoriesPageTitle,
                    QLabel#customersPageTitle,
                    QLabel#staffPageTitle,
                    QLabel#ordersPageTitle,
                    QLabel#invoicesPageTitle {
                    color: #202124;
                    font-size: 26px;
                    font-weight: bold;
                    }

                    QLabel#productsPageDescription,
                    QLabel#categoriesPageDescription,
                    QLabel#customersPageDescription,
                    QLabel#staffPageDescription,
                    QLabel#ordersPageDescription,
                    QLabel#invoicesPageDescription {
                    color: #777777;
                    font-size: 14px;
                    }
                </string>
            </property>

