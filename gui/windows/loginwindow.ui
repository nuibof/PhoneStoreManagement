        <widget class="QWidget" name="centralwidget">
            <property name="styleSheet">
                <string notr="true">
                    QWidget#centralwidget {
                    background-color: #F5F7FA;
                    }

                    QLabel {
                    color: #202124;
                    }

                    QLabel#lblTitle {
                    font-size: 28px;
                    font-weight: bold;
                    color: #111111;
                    }

                    QLabel#lblSubtitle {
                    font-size: 14px;
                    color: #666666;
                    }

                    QLabel#lblUsername,
                    QLabel#lblPassword {
                    font-size: 13px;
                    font-weight: bold;
                    color: #444444;
                    }

                    QFrame#loginCard {
                    background-color: #FFFFFF;
                    border: 1px solid #E0E0E0;
                    border-radius: 16px;
                    }

                    QLineEdit {
                    background-color: #FFFFFF;
                    color: #222222;
                    border: 1px solid #D0D0D0;
                    border-radius: 8px;
                    padding: 10px 12px;
                    font-size: 14px;
                    }

                    QLineEdit:focus {
                    border: 1px solid #3478F6;
                    }

                    QPushButton#btnLogin {
                    background-color: #3478F6;
                    color: white;
                    border: none;
                    border-radius: 8px;
                    padding: 11px;
                    font-size: 14px;
                    font-weight: bold;
                    }

                    QPushButton#btnLogin:hover {
                    background-color: #4A8CFF;
                    }

                    QPushButton#btnLogin:pressed {
                    background-color: #2864D7;
                    }

                    QPushButton#btnExit {
                    background-color: transparent;
                    color: #666666;
                    border: 2px solid #CCCCCC;
                    border-radius: 8px;
                    padding: 8px;
                    font-size: 13px;
                    }

                    QPushButton#btnExit:hover {
                    color: #222222;
                    }
                </string>
            </property>

