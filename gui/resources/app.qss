QWidget { font-family: "Segoe UI"; font-size: 13px; color: #202124; }
QMainWindow, QDialog, QWidget#centralwidget, QWidget#CustomersPage, QWidget#ProductsPage,
QWidget#StaffPage, QWidget#OrdersPage, QWidget#InvoicesPage { background: #F5F7FA; }
QLabel { background: transparent; }
QLabel#lblTitle, QLabel#lblWelcome { font-size: 26px; font-weight: 600; }
QDialog QLabel#lblTitle { font-size: 22px; }
QLabel#lblSubtitle { color: #687382; font-size: 14px; }
QLabel#lblProductName, QLabel#lblLogo { color: #3478F6; font-weight: 600; }
QLabel#lblLogo { font-size: 20px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
 background: white; border: 1px solid #D0D7E2; border-radius: 6px; padding: 7px 10px;
 selection-background-color: #3478F6; selection-color: white;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { min-height: 22px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus { border-color: #3478F6; }
QComboBox QAbstractItemView { background: white; color: #202124; selection-background-color: #EAF1FF; selection-color: #202124; }
QPushButton { background: white; border: 1px solid #D0D7E2; border-radius: 6px; padding: 8px 14px; min-height: 20px; }
QPushButton:hover { background: #EAF1FF; border-color: #A9C6FA; }
QPushButton:pressed { background: #DCE8FF; }
QPushButton:focus { border: 1px solid #3478F6; }
QPushButton#btnAdd, QPushButton#btnSave, QPushButton#btnLogin, QPushButton[primary="true"] {
 background: #3478F6; color: white; border-color: #3478F6; font-weight: 600;
}
QPushButton#btnAdd:hover, QPushButton#btnSave:hover, QPushButton#btnLogin:hover, QPushButton[primary="true"]:hover { background: #2864D7; }
QPushButton[action="edit"], QPushButton[action="delete"] { padding: 0; min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px; background: white; border: 1px solid #D0D7E2; border-radius: 4px; }
QPushButton[action="edit"]:hover, QPushButton[action="delete"]:hover { background: #EAF1FF; border-color: #3478F6; }
QPushButton:disabled, QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
 background: #EDF0F4; color: #8A94A3; border-color: #DFE4EB;
}
QTableWidget { background: white; alternate-background-color: #F8FAFD; border: 1px solid #DFE4EB;
 border-radius: 8px; selection-background-color: #EAF1FF; selection-color: #202124; }
QTableWidget::item { padding: 0px 8px; }
QTableWidget::item:selected { background: #EAF1FF; color: #202124; }
QHeaderView::section { background: #F8F9FB; color: #526071; font-weight: 600; padding: 10px 8px;
 border: none; border-bottom: 1px solid #DFE4EB; border-right: 1px solid #E8ECF2; }
QWidget#actionWidget { background: transparent; }
QFrame#sideBar { background: white; border-right: 1px solid #DFE4EB; }
QFrame#sideBar QPushButton { text-align: left; background: transparent; border: none; padding: 12px 16px; }
QFrame#sideBar QPushButton:hover, QFrame#sideBar QPushButton[active="true"] { background: #EAF1FF; color: #3478F6; }
QFrame#sideBar QPushButton[active="true"] { font-weight: 600; }
QFrame#sideBar QPushButton#btnLogout:hover { background: #FFF0F0; color: #C62828; }
QFrame#cardProducts, QFrame#cardOrders, QFrame#cardCustomers, QFrame#loginCard, QGroupBox {
 background: white; border: 1px solid #DFE4EB; border-radius: 10px;
}
QLabel#productsValue, QLabel#ordersValue, QLabel#customersValue { font-size: 32px; font-weight: 600; color: #3478F6; }
QScrollBar:vertical { background: #F5F7FA; width: 12px; margin: 0; }
QScrollBar:horizontal { background: #F5F7FA; height: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #BCC6D4; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:horizontal { background: #BCC6D4; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QToolTip { background: #202124; color: white; padding: 5px; border: none; }
