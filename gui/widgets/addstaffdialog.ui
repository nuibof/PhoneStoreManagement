                <height>520</height>
            </rect>
        </property>

        <property name="windowTitle">
            <string>Add Staff</string>
        </property>

        <property name="styleSheet">
            <string notr="true">

                QDialog {
                background-color: #F5F7FA;
                }

                QLabel#lblTitle {
                color: #202124;
                font-size: 24px;
                font-weight: bold;
                }

                QLabel#lblSubtitle {
                color: #777777;
                font-size: 13px;
                }

                QLabel.formLabel {
                color: #444444;
                font-size: 13px;
                font-weight: bold;
                }

                QLineEdit,
                QComboBox {
                background-color: #FFFFFF;
                color: #222222;
                border: 1px solid #D0D0D0;
                border-radius: 8px;
                padding: 9px 12px;
                font-size: 14px;
                min-height: 20px;
                }

                QLineEdit:focus,
                QComboBox:focus {
                border: 1px solid #3478F6;
                }

                QComboBox::drop-down {
                border: none;
                width: 30px;
                }

                QPushButton#btnCancel {
                background-color: #FFFFFF;
                color: #555555;
                border: 1px solid #D0D0D0;
                border-radius: 8px;
                padding: 10px 20px;
                font-size: 14px;
                font-weight: bold;
                }

                QPushButton#btnCancel:hover {
                background-color: #F0F4FF;
                color: #3478F6;
                border: 1px solid #B8C9F5;
                }

                QPushButton#btnSave {
                background-color: #3478F6;
                color: #FFFFFF;
                border: none;
                border-radius: 8px;
                padding: 10px 24px;
                font-size: 14px;
                font-weight: bold;
                }

                QPushButton#btnSave:hover {
                background-color: #4A8CFF;
                }

                QPushButton#btnSave:pressed {
                background-color: #2864D7;
                }

            </string>
        </property>

